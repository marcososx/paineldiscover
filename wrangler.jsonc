{
  // Painel de Crise Brusque Discover — site estático servido por Worker de assets.
  // Página pública = / (dashboard). Admin = /admin.html.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paineldiscover",
  "compatibility_date": "2025-07-01",
  "main": "src/index.js",
  "assets": { "directory": "./public" },
  "triggers": { "crons": ["*/1 * * * *"] },
  "observability": { "enabled": true }
}
